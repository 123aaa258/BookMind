# BookMind 环境变量样例（复制为本地 .env 使用，绝不要把真实 Key 提交到 Git！）
BOOKMIND_PORT=8080
BOOKMIND_LIBRARY_DIR=./samples/books
BOOKMIND_DATA_DIR=./data
BOOKMIND_PLUGINS_DIR=./plugins
BOOKMIND_PLUGIN_TIMEOUT_MS=15000

# OpenAI 兼容伴读模型配置（支持 OpenAI / DeepSeek / 通义千问 / 智谱 / 本地 Ollama）
BOOKMIND_LLM_BASE_URL=https://api.openai.com/v1
BOOKMIND_LLM_API_KEY=replace-with-your-own-key
BOOKMIND_LLM_MODEL=gpt-4o-mini
BOOKMIND_LLM_TIMEOUT_SECONDS=30
BOOKMIND_RAG_TOP_K=5
